<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <title>Our Home Energy Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
    :root {
      --cream: #FFF9EC;
      --ink: #2E2A24;
      --sun: #FFC94A;
      --sun-deep: #F2A93B;
      --leaf: #3FA66B;
      --leaf-light: #DCF3E4;
      --sky: #4FA3D1;
      --sky-light: #DDF0F9;
      --coral: #FF6F5E;
      --coral-light: #FFE3DF;
      --lav: #8C7FD1;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--cream);
      font-family: 'Nunito Sans', sans-serif;
      color: var(--ink);
      padding: 24px 20px 60px;
    }

    .wrap {
      max-width: 760px;
      margin: 0 auto;
    }

    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
      gap: 10px;
    }

    .profile {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .avatar {
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: var(--sun);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      border: 3px solid #fff;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
      flex-shrink: 0;
    }

    .profile .who {
      line-height: 1.2;
    }

    .profile .who .hi {
      font-weight: 800;
      font-size: 1.02rem;
      font-family: 'Baloo 2', sans-serif;
    }

    .profile .who .role {
      font-weight: 600;
      font-size: 0.75rem;
      color: #8A8272;
    }

    .gear-btn {
      background: #fff;
      border: 2px solid #EFE6D2;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      font-size: 1.15rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform .15s ease;
    }

    .gear-btn:hover {
      transform: rotate(25deg);
    }

    header {
      margin-bottom: 16px;
    }

    header h1 {
      font-family: 'Baloo 2', sans-serif;
      font-weight: 800;
      font-size: 1.7rem;
      margin: 0 0 10px 0;
      line-height: 1.15;
    }

    .home-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .home-tab {
      background: #fff;
      border: 2px solid #EFE6D2;
      padding: 8px 16px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      color: var(--ink);
    }

    .home-tab.active {
      background: var(--leaf);
      color: #fff;
      border-color: var(--leaf);
    }

    .mascot-row {
      display: flex;
      align-items: flex-end;
      gap: 10px;
      margin-bottom: 16px;
    }

    .mascot {
      font-size: 2.4rem;
      flex-shrink: 0;
    }

    .bubble {
      background: #fff;
      border-radius: 16px 16px 16px 4px;
      padding: 10px 16px;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
      max-width: 480px;
    }

    .hero {
      background: linear-gradient(135deg, var(--sun) 0%, var(--sun-deep) 100%);
      border-radius: 28px;
      padding: 26px 30px;
      display: flex;
      align-items: center;
      gap: 22px;
      flex-wrap: wrap;
      margin-bottom: 22px;
    }

    .hero .bolt {
      font-size: 3rem;
    }

    .hero .big {
      font-family: 'Baloo 2', sans-serif;
      font-weight: 800;
      font-size: 2.7rem;
      line-height: 1;
    }

    .hero .big span {
      font-size: 1.2rem;
      font-weight: 700;
    }

    .hero .sub {
      font-weight: 600;
      font-size: 0.95rem;
      max-width: 320px;
    }

    .hero .note {
      font-weight: 700;
      font-size: 0.78rem;
      margin-top: 6px;
      opacity: 0.85;
      max-width: 320px;
    }

    section {
      margin-bottom: 22px;
    }

    .section-title {
      font-family: 'Baloo 2', sans-serif;
      font-weight: 700;
      font-size: 1.1rem;
      margin: 0 0 12px 2px;
    }

    .app-row {
      display: grid;
      grid-template-columns: 38px 148px 1fr 78px;
      align-items: center;
      gap: 12px;
      padding: 8px 4px;
      border-radius: 14px;
      cursor: pointer;
      transition: background .15s ease;
    }

    .app-row:hover {
      background: #F3ECDA;
    }

    .app-row .icon {
      font-size: 1.4rem;
      text-align: center;
    }

    .app-row .name {
      font-weight: 700;
      font-size: 0.88rem;
    }

    .app-row .name small {
      display: block;
      font-weight: 600;
      font-size: 0.7rem;
      color: #8A8272;
    }

    .track {
      background: #F0E9D8;
      border-radius: 999px;
      height: 13px;
      overflow: hidden;
    }

    .fill {
      height: 100%;
      border-radius: 999px;
      transition: width .3s ease;
    }

    .app-row .val {
      font-weight: 800;
      font-size: 0.82rem;
      text-align: right;
    }

    .hog {
      background: var(--coral-light);
      border-radius: 24px;
      padding: 20px 24px;
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    .hog .icon {
      font-size: 2.3rem;
      background: var(--coral);
      width: 58px;
      height: 58px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .hog .text strong {
      font-family: 'Baloo 2', sans-serif;
      font-size: 1.05rem;
      display: block;
      margin-bottom: 2px;
    }

    .hog .text {
      font-size: 0.88rem;
      font-weight: 600;
    }

    .savings {
      background: var(--leaf-light);
      border-radius: 24px;
      padding: 20px 24px;
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      margin-bottom: 16px;
    }

    .savings .icon {
      font-size: 2.3rem;
      background: var(--leaf);
      width: 58px;
      height: 58px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .savings .amount {
      font-family: 'Baloo 2', sans-serif;
      font-weight: 800;
      font-size: 1.45rem;
      color: #256B45;
    }

    .savings .text {
      font-size: 0.88rem;
      font-weight: 600;
      max-width: 420px;
    }

    .tip-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .tip-card {
      background: #fff;
      border: 2px solid var(--sky-light);
      border-radius: 18px;
      padding: 14px 16px;
      display: flex;
      gap: 12px;
      align-items: flex-start;
    }

    .tip-card .ticon {
      font-size: 1.3rem;
      flex-shrink: 0;
    }

    .tip-card .tname {
      font-weight: 800;
      font-size: 0.83rem;
      display: block;
      margin-bottom: 3px;
    }

    .tip-card .tdesc {
      font-size: 0.76rem;
      font-weight: 600;
      color: #5B5548;
      line-height: 1.35;
    }

    .history-card {
      background: #fff;
      border: 2px solid #EFE6D2;
      border-radius: 16px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 8px;
    }

    .history-card .hleft {
      font-weight: 700;
      font-size: 0.85rem;
    }

    .history-card .hleft small {
      display: block;
      font-weight: 600;
      font-size: 0.72rem;
      color: #8A8272;
    }

    .history-card .hright {
      font-weight: 800;
      font-size: 0.9rem;
    }

    .save-btn {
      background: var(--sky);
      color: #fff;
      border: none;
      padding: 11px 18px;
      border-radius: 14px;
      font-weight: 800;
      font-size: 0.85rem;
      cursor: pointer;
      margin-bottom: 14px;
    }

    .compare-row {
      display: flex;
      gap: 10px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .compare-row select {
      flex: 1;
      min-width: 140px;
      padding: 9px 10px;
      border-radius: 12px;
      border: 2px solid #EFE6D2;
      font-weight: 700;
      font-size: 0.82rem;
      background: var(--cream);
      color: var(--ink);
    }

    .compare-result {
      background: var(--sky-light);
      border-radius: 16px;
      padding: 14px 16px;
      font-weight: 700;
      font-size: 0.85rem;
      color: #1F5E7D;
      display: none;
    }

    .error-msg {
      font-size: 0.8rem;
      font-weight: 700;
      color: #B23B2E;
      background: var(--coral-light);
      border-radius: 12px;
      padding: 8px 12px;
      margin-bottom: 10px;
    }

    .muted-msg {
      font-size: 0.82rem;
      font-weight: 600;
      color: #8A8272;
      margin-bottom: 10px;
    }

    .history-card .hright {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .history-card .hdel {
      cursor: pointer;
      font-size: 0.68rem;
      font-weight: 800;
      color: #B23B2E;
      background: var(--coral-light);
      padding: 3px 9px;
      border-radius: 999px;
    }

    footer {
      text-align: center;
      font-size: 0.78rem;
      color: #8A8272;
      margin-top: 30px;
      font-weight: 600;
    }

    .overlay {
      position: fixed;
      inset: 0;
      background: rgba(46, 42, 36, 0.35);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      z-index: 10;
    }

    .overlay.open {
      display: flex;
    }

    .modal {
      background: #fff;
      border-radius: 22px;
      padding: 26px 26px 20px;
      width: 100%;
      max-width: 340px;
      max-height: 85vh;
      overflow-y: auto;
    }

    .modal h2 {
      font-family: 'Baloo 2', sans-serif;
      margin: 0 0 14px 0;
      font-size: 1.2rem;
    }

    .field {
      margin-bottom: 14px;
    }

    .field label {
      display: block;
      font-weight: 700;
      font-size: 0.78rem;
      margin-bottom: 5px;
      color: #5B5548;
    }

    .field input,
    .field select {
      width: 100%;
      padding: 9px 12px;
      border-radius: 12px;
      border: 2px solid #EFE6D2;
      font-family: 'Nunito Sans', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--ink);
      background: var(--cream);
    }

    .avatar-pick {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .avatar-pick .opt {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
      background: var(--cream);
      border: 2px solid #EFE6D2;
      cursor: pointer;
    }

    .avatar-pick .opt.selected {
      border-color: var(--leaf);
      background: var(--leaf-light);
    }

    .modal-actions {
      display: flex;
      gap: 10px;
      margin-top: 6px;
    }

    .btn {
      flex: 1;
      padding: 10px 14px;
      border-radius: 14px;
      font-weight: 800;
      font-size: 0.85rem;
      border: none;
      cursor: pointer;
      font-family: 'Nunito Sans', sans-serif;
    }

    .btn.save {
      background: var(--leaf);
      color: #fff;
    }

    .btn.cancel {
      background: #F0E9D8;
      color: var(--ink);
    }

    .account-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:10px;
      background:var(--cream);
      border:2px solid #EFE6D2;
      border-radius:14px;
      padding:8px 12px;
      margin-bottom:8px;
      cursor:pointer;
    }
    .account-row.active{
      border-color:var(--leaf);
      background:var(--leaf-light);
    }
    .account-row .aleft{
      display:flex;
      align-items:center;
      gap:10px;
      font-weight:700;
      font-size:0.85rem;
    }
    .account-row .aleft .av{font-size:1.2rem;}
    .account-row .switch-label{
      font-weight:700;
      font-size:0.72rem;
      color:var(--leaf);
    }

    @media (max-width:480px) {
      .tip-grid {
        grid-template-columns: 1fr;
      }
    }
    </style>
  </head>

  <body>
    <div class="wrap">

      <div class="topbar">
        <div class="profile">
          <div class="avatar" id="avatarDisplay">🙂</div>
          <div class="who">
            <div class="hi" id="nameDisplay">Hi there!</div>
            <div class="role">Home Energy Explorer</div>
          </div>
        </div>
        <div style="display:flex; gap:8px;">
          <button class="gear-btn" id="signOutBtn" title="Sign out">🚪</button>
          <button class="gear-btn" id="openSettings" title="Profile settings">⚙️</button>
        </div>
      </div>

      <header>
        <h1>⚡ Our Home Energy Dashboard</h1>
      </header>

      <div class="home-tabs">
        <div class="home-tab active" data-home="home1">🏠 Home 1</div>
        <div class="home-tab" data-home="home2">🏡 Home 2</div>
      </div>

      <div class="mascot-row">
        <div class="mascot">💡</div>
        <div class="bubble" id="mascotLine">Let's see how much energy your home used this month!</div>
      </div>

      <div class="hero">
        <div class="bolt">🔌</div>
        <div>
          <div class="big" id="totalUnits">0 <span>units used</span></div>
          <div class="sub" id="totalSub">Added up across all appliances this month.</div>
          <div class="note">1 unit = 1 kWh — the same "unit" your electricity bill counts.</div>
        </div>
      </div>

      <section>
        <div class="section-title">🔧 Energy by Appliance</div>
        <div id="applianceList"></div>
      </section>

      <section>
        <div class="section-title">😬 Power Hog of the Month</div>
        <div class="hog">
          <div class="icon" id="hogIcon">⚡</div>
          <div class="text" id="hogText"></div>
        </div>
      </section>

      <section>
        <div class="section-title">🐷 Money We Saved</div>
        <div class="savings">
          <div class="icon">💰</div>
          <div>
            <div class="amount" id="savingsAmount">₹390 saved this month</div>
            <div class="text" id="savingsText">10% off our usual ₹3,900 bill, just from setting the AC to 24°C and switching off lights when we leave a room.</div>
          </div>
        </div>

        <div class="tip-grid" id="tipGrid"></div>
      </section>

      <section>
        <div class="section-title">📊 History &amp; Compare</div>
        <button class="save-btn" id="saveSnapshotBtn">💾 Save this month's data</button>
        <div id="historyList">Loading saved months…</div>

        <div class="compare-row">
          <select id="compareA">
            <option value="">Compare: pick month A</option>
          </select>
          <select id="compareB">
            <option value="">Compare: pick month B</option>
          </select>
        </div>
        <div class="compare-result" id="compareResult"></div>
      </section>

      <footer>Green = low use · Blue/Purple = medium use · Orange/Red = biggest energy eaters</footer>
    </div>

    <div class="overlay" id="settingsOverlay">
      <div class="modal">
        <h2>⚙️ Account Settings</h2>
        <div class="field">
          <label>Your name</label>
          <input type="text" id="nameInput" placeholder="e.g. Aa">
        </div>
        <div class="field">
          <label>Pick an avatar</label>
          <div class="avatar-pick" id="avatarPick">
            <div class="opt selected" data-emoji="🙂">🙂</div>
            <div class="opt" data-emoji="🦸">🦸</div>
            <div class="opt" data-emoji="🐼">🐼</div>
            <div class="opt" data-emoji="🌻">🌻</div>
            <div class="opt" data-emoji="🚀">🚀</div>
            <div class="opt" data-emoji="🌟">🌟</div>
          </div>
        </div>
        <div id="settingsError"></div>
        <div class="modal-actions">
          <button class="btn cancel" id="cancelSettings">Cancel</button>
          <button class="btn save" id="saveSettings">Save</button>
        </div>
      </div>
    </div>

    <div class="overlay open" id="authOverlay" style="z-index:20;">
      <div class="modal">
        <h2 id="authTitle">👋 Sign In</h2>
        <div class="field">
          <label>Email</label>
          <input type="email" id="authEmail" autocomplete="email">
        </div>
        <div class="field">
          <label>Password</label>
          <input type="password" id="authPassword" autocomplete="current-password">
        </div>
        <div id="authError"></div>
        <div class="modal-actions">
          <button class="btn cancel" id="authToggleMode">Need an account?</button>
          <button class="btn save" id="authSubmit">Sign In</button>
        </div>
      </div>
    </div>

    <div class="overlay" id="applianceOverlay">
      <div class="modal" id="applianceModal" style="max-width:360px;">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:14px;">
          <div class="avatar" id="detailIcon" style="width:52px;height:52px;font-size:1.7rem;background:var(--leaf-light);">💡</div>
          <div>
            <h2 style="margin:0;" id="detailName">Appliance</h2>
            <div style="font-weight:700; font-size:0.78rem; color:#8A8272;" id="detailWatt">0W</div>
          </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:14px;">
          <div style="background:var(--cream); border-radius:14px; padding:10px 12px;">
            <div style="font-weight:700; font-size:0.72rem; color:#8A8272;">Runtime</div>
            <div style="font-weight:800; font-size:0.95rem;" id="detailHours">0 hrs/day</div>
          </div>
          <div style="background:var(--cream); border-radius:14px; padding:10px 12px;">
            <div style="font-weight:700; font-size:0.72rem; color:#8A8272;">Share of bill</div>
            <div style="font-weight:800; font-size:0.95rem;" id="detailShare">0%</div>
          </div>
          <div style="background:var(--cream); border-radius:14px; padding:10px 12px;">
            <div style="font-weight:700; font-size:0.72rem; color:#8A8272;">Daily use</div>
            <div style="font-weight:800; font-size:0.95rem;" id="detailDaily">0 units</div>
          </div>
          <div style="background:var(--cream); border-radius:14px; padding:10px 12px;">
            <div style="font-weight:700; font-size:0.72rem; color:#8A8272;">Monthly use</div>
            <div style="font-weight:800; font-size:0.95rem;" id="detailMonthly">0 units</div>
          </div>
        </div>

        <div style="background:var(--leaf-light); border-radius:14px; padding:12px 14px; margin-bottom:14px;">
          <div style="font-weight:700; font-size:0.72rem; color:#256B45;">Estimated monthly cost</div>
          <div style="font-weight:800; font-size:1.15rem; color:#256B45;" id="detailCost">₹0</div>
          <div style="font-weight:600; font-size:0.7rem; color:#256B45; margin-top:2px;" id="detailCostNote">(estimated using Tamil Nadu's TANGEDCO/TNEB tariff slabs — real bills can vary)</div>
        </div>

        <div style="background:var(--sky-light); border-radius:14px; padding:12px 14px; margin-bottom:16px;">
          <div style="font-weight:700; font-size:0.72rem; color:#1F5E7D; margin-bottom:3px;">💡 Saving tip</div>
          <div style="font-weight:600; font-size:0.82rem; color:#1F5E7D;" id="detailTip">Tip goes here.</div>
        </div>

        <button class="btn cancel" style="width:100%;" id="closeApplianceDetail">Close</button>
      </div>
    </div>

    <script>
    // Global safety net: show ANY otherwise-uncaught error or promise
    // rejection as an on-screen banner, since mobile browsers don't give
    // easy access to the JS console for debugging.
    window.addEventListener("error", (e) => {
      console.error("Uncaught error:", e.error || e.message);
      const banner = document.createElement("div");
      banner.
